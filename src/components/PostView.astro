---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LangSwitch from './LangSwitch.astro';
import { type Post, postSlug } from '../lib/posts';
import { type Lang, useTranslations, localePath, otherLang, formatDate } from '../i18n/ui';

interface Props {
  lang: Lang;
  post: Post;
  hasTranslation: boolean;
}
const { lang, post, hasTranslation } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
const altHref = localePath(otherLang(lang), hasTranslation ? `/posts/${postSlug(post)}/` : '/');
---

<Base lang={lang} title={post.data.title} description={post.data.description} altHref={altHref}>
  <a class="skip-link" href="#content">{t('a11y.skip')}</a>
  <div class="page">
    <nav class="topbar">
      <a class="back-link" href={`${localePath(lang)}#writing`}>
        <span class="arrow" aria-hidden="true">←</span> {t('post.back')}
      </a>
      <LangSwitch lang={lang} href={altHref} />
    </nav>
    <main id="content">
      <article>
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <div class="card-meta">
            <time class="date" datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatDate(post.data.date, lang)}
            </time>
            {
              post.data.tags.length > 0 && (
                <ul class="tags">
                  {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
              )
            }
          </div>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
      <footer class="post-footer">
        <a class="back-link" href={`${localePath(lang)}#writing`}>
          <span class="arrow" aria-hidden="true">←</span> {t('post.back')}
        </a>
      </footer>
    </main>
  </div>
</Base>
