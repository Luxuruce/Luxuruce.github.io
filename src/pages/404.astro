---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
---

<Base lang="zh" title="404" altHref="/en/">
  <main class="container">
    <h1>404</h1>
    <p>{ui.zh['notFound.title']} · {ui.en['notFound.title']}</p>
    <p><a href="/">{ui.zh['notFound.back']}</a> · <a href="/en/">{ui.en['notFound.back']}</a></p>
  </main>
</Base>
